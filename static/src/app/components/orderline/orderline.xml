<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Línea del ticket de tienda.

        La plantilla base coloca cantidad y descripción como columnas de un
        flex centrado verticalmente. Metiendo ahí también la referencia, el
        nombre se quedaba en una columna estrecha y centrada a media altura:
        con nombres largos el resultado era ilegible.

        Aquí el nombre ocupa todo el ancho que le queda a la línea, y la
        referencia baja a la lista de detalle junto al precio unitario:

            1  Carrito de bebé City Tour 2 Baby Jogger (Exposición)  899,00 €
               AUTO-92364 · 899,00 €/ud
    -->
    <t t-name="cs_bebemalaga_reports.Orderline"
       t-inherit="point_of_sale.Orderline"
       t-inherit-mode="extension">

        <!--
            Alineación arriba en lugar de centrada: con el nombre a varias
            líneas, la cantidad y el importe deben quedar a la altura de la
            primera, no flotando en mitad del bloque.
        -->
        <xpath expr="//div[hasclass('line-details')]" position="attributes">
            <attribute name="t-att-class">{ 'align-items-start': bmIsReceipt }</attribute>
        </xpath>
        <xpath expr="//div[hasclass('product-name')]" position="attributes">
            <attribute name="t-att-class">{ 'align-items-start': bmIsReceipt }</attribute>
        </xpath>

        <!--
            Referencia, precio unitario y descuento en un solo renglón.

            Sustituye en el ticket al renglón del core, que imprime
            "899,00 € / Unidades": el nombre de la unidad de medida no aporta
            nada en tienda y gasta una línea de papel por artículo. En pantalla
            se mantiene el del core con su condición original.

            El ancla es el <li> del precio unitario, que en esta compilación es
            el único 'price-per-unit' cuya condición mira la cantidad.
        -->
        <xpath expr="//li[hasclass('price-per-unit')][contains(@t-if, 'getQuantity')]" position="before">
            <li t-if="bmIsReceipt" class="bm-line-info">
                <t t-if="bmProductRef"><t t-esc="bmProductRef"/></t>
                <t t-if="!props.basic_receipt">
                    <t t-if="bmProductRef"> · </t>
                    <t t-esc="bmUnitPrice"/>/ud
                    <t t-if="bmDiscount"> <t t-esc="bmDiscount"/></t>
                </t>
            </li>
        </xpath>
        <xpath expr="//li[hasclass('price-per-unit')][contains(@t-if, 'getQuantity')]" position="attributes">
            <attribute name="t-if">!bmIsReceipt and !props.basic_receipt and this.props.line.getQuantity() != 1 and line.price_type !== 'original' and !line.combo_parent_id</attribute>
        </xpath>

        <!-- El descuento en inglés del core sobra en el ticket: ya va en el renglón de arriba -->
        <xpath expr="//li[@t-if='line.discount']" position="attributes">
            <attribute name="t-if">line.discount and !bmIsReceipt</attribute>
        </xpath>

    </t>

</templates>
