<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Documento de mercancía retirada.

        No existe en Odoo. Se emite sobre el albarán de salida cuando el
        cliente recoge el material, y lleva la misma información que el
        pedido y la factura: referencia, descripción, cantidad, precio
        unitario, descuento e importe, más la firma de conformidad.
    -->
    <template id="report_goods_withdrawal_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o._get_report_lang())"/>
            <t t-set="partner" t-value="o.partner_id"/>
            <t t-set="lines" t-value="o._bm_withdrawal_lines()"/>
            <t t-set="totals" t-value="o._bm_withdrawal_totals()"/>
            <t t-set="currency" t-value="o.company_id.currency_id"/>

            <t t-set="address">
                <div t-if="partner" t-field="o.partner_id"
                     t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                <p t-if="partner.vat" class="mb-0">
                    <t t-out="o.company_id.account_fiscal_country_id.vat_label or 'NIF'"/>:
                    <span t-field="partner.vat"/>
                </p>
            </t>

            <div class="page">
                <t t-set="layout_document_title">
                    <span>Documento de mercancía retirada # </span>
                    <span t-field="o.name">WH/OUT/0001</span>
                </t>

                <div class="row mb-4" id="informations">
                    <div t-if="o.origin" class="col" name="bm_origin">
                        <strong>Pedido</strong>
                        <div t-field="o.origin">S00014</div>
                    </div>
                    <div class="col" name="bm_date">
                        <strong>Fecha de retirada</strong>
                        <div t-if="o.date_done" t-field="o.date_done"
                             t-options="{'widget': 'date'}">28/07/2026</div>
                        <div t-else="" t-field="o.scheduled_date"
                             t-options="{'widget': 'date'}">28/07/2026</div>
                    </div>
                    <div t-if="o.user_id" class="col" name="bm_salesperson">
                        <strong>Comercial</strong>
                        <div t-field="o.user_id">Humberto</div>
                    </div>
                </div>

                <table class="o_has_total_table table o_main_table table-borderless">
                    <thead style="display: table-row-group">
                        <tr>
                            <th name="th_bm_description" class="text-start">Descripción</th>
                            <th name="th_bm_quantity" class="text-end">Cantidad</th>
                            <th name="th_bm_priceunit" class="text-end text-nowrap">Precio unitario</th>
                            <th name="th_bm_discount" class="text-end">Descuento</th>
                            <th name="th_bm_subtotal" class="text-end">Importe</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="lines" t-as="line" name="tr_bm_product">
                            <td name="td_bm_name">
                                <span t-if="line['ref']">[<t t-out="line['ref']"/>]</span>
                                <t t-out="line['name']">Carrito 2 en 1 Donkey 6 Bugaboo</t>
                            </td>
                            <td name="td_bm_quantity" class="text-end">
                                <span t-out="line['quantity']"
                                      t-options="{'widget': 'integer'}">1</span>
                            </td>
                            <td name="td_bm_priceunit" class="text-end text-nowrap">
                                <span t-out="line['price_unit']"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}">1.399,00</span>
                            </td>
                            <td name="td_bm_discount" class="text-end">
                                <span t-if="line['discount']">
                                    <t t-out="line['discount']" t-options="{'widget': 'integer'}"/>%
                                </span>
                            </td>
                            <td name="td_bm_subtotal" class="text-end o_price_total">
                                <span t-out="line['subtotal']"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}">1.399,00</span>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="clearfix" name="bm_total_summary">
                    <div id="total" class="row mt-n3">
                        <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                            <table class="o_total_table table table-borderless">
                                <tr>
                                    <td>Base imponible</td>
                                    <td class="text-end">
                                        <span t-out="totals['untaxed']"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}">1.490,90</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>IVA</td>
                                    <td class="text-end">
                                        <span t-out="totals['tax']"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}">12,59</span>
                                    </td>
                                </tr>
                                <tr class="border-black o_total">
                                    <td><strong>Total</strong></td>
                                    <td class="text-end">
                                        <span t-out="totals['total']"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}">1.503,49</span>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <t t-call="cs_bebemalaga_reports.conformity_signature">
                    <t t-set="signature_image" t-value="o.signature"/>
                    <t t-set="signature_name" t-value="partner.name"/>
                </t>

                <t t-call="cs_bebemalaga_reports.legal_notes"/>
            </div>
        </t>
    </template>

    <template id="report_goods_withdrawal">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="cs_bebemalaga_reports.report_goods_withdrawal_document"
                   t-lang="o._get_report_lang()"/>
            </t>
        </t>
    </template>

</odoo>
