<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Factura: mismos criterios de columnas que el presupuesto -->
    <template id="report_invoice_document_bm"
              inherit_id="account.report_invoice_document">

        <xpath expr="//t[@t-set='display_taxes']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>

        <xpath expr="//t[@t-set='display_discount']" position="attributes">
            <attribute name="t-value">True</attribute>
        </xpath>

        <xpath expr="//th[@name='th_discount']" position="replace">
            <th name="th_discount" t-if="display_discount"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Descuento</span>
            </th>
        </xpath>

        <!-- Cantidad: entero, sin unidad de medida -->
        <xpath expr="//td[@name='td_quantity']" position="replace">
            <td name="td_quantity" class="o_td_quantity text-end">
                <span t-field="line.quantity"
                      t-options="{'widget': 'integer'}"
                      class="text-nowrap">3</span>
            </td>
        </xpath>

        <xpath expr="//td[@name='td_discount']" position="replace">
            <td name="td_discount" t-if="display_discount"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span t-if="line.discount" class="text-nowrap">
                    <t t-out="line.discount" t-options="{'widget': 'integer'}"/>%
                </span>
            </td>
        </xpath>

        <!--
            Importe cobrado y pendiente. En la factura salen de datos nativos:
            amount_residual es lo que queda por cobrar.
        -->
        <xpath expr="//table[hasclass('o_total_table')]" position="inside">
            <t t-if="o.state == 'posted' and o.move_type in ('out_invoice', 'out_refund')">
                <tr class="border-black o_subtotal" name="bm_amount_paid">
                    <td><strong>Importe cobrado</strong></td>
                    <td class="text-end">
                        <span t-out="o.amount_total - o.amount_residual"
                              t-options="{'widget': 'monetary', 'display_currency': o.currency_id}">0,00</span>
                    </td>
                </tr>
                <tr name="bm_amount_pending">
                    <td><strong>Importe pendiente</strong></td>
                    <td class="text-end">
                        <span t-field="o.amount_residual">0,00</span>
                    </td>
                </tr>
            </t>
        </xpath>

        <!--
            Firma y avisos legales van *fuera* del contenedor de los totales.

            En la factura el bloque de totales cuelga de #right-elements, que
            es una columna estrecha flotada a la derecha (col-5 float-end).
            Insertando ahí, el recuadro de firma salía comprimido y los
            avisos legales en una columna de media página. Se anclan al padre
            de #right-elements para recuperar el ancho completo, igual que en
            el pedido.
        -->
        <xpath expr="//div[@id='right-elements']/.." position="after">
            <t t-call="cs_bebemalaga_reports.conformity_signature">
                <t t-set="signature_image" t-value="False"/>
                <t t-set="signature_name" t-value="False"/>
            </t>
            <t t-call="cs_bebemalaga_reports.legal_notes"/>
        </xpath>

    </template>

    <!-- "Base imponible" en lugar de la traducción por defecto "Importe base" -->
    <template id="document_tax_totals_bm_account"
              inherit_id="account.document_tax_totals">
        <xpath expr="//tr[hasclass('o_subtotal')]/td[1]" position="replace">
            <td>Base imponible</td>
        </xpath>
    </template>

</odoo>
